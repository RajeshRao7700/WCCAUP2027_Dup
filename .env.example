# Public frontend configuration only. NEVER put secrets in VITE_* variables.

# Base URL of the Spring Boot backend (no trailing slash)
VITE_API_BASE_URL=

# Conference identification for this multi-tenant backend
VITE_CONFERENCE_SHORT_NAME=WCCAUP2027

# true  -> UI runs on the local mock data layer
# false -> UI calls the real public API endpoints
VITE_USE_MOCK_DATA=true

# Canonical public site URL used for SEO metadata
VITE_SITE_URL=https://WCCAUP2027.org

# Razorpay Key ID (public test or live key ID)
VITE_RAZORPAY_KEY_ID=rzp_test_TaJstYd6vsQoTu
